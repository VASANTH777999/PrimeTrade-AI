{
  "info": {
    "name": "PrimeTrade AI API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "http://127.0.0.1:8000/api/v1/auth/register", "protocol": "http", "host": ["127","0","0","1"], "port": "8000", "path": ["api","v1","auth","register"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}" }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "http://127.0.0.1:8000/api/v1/auth/login", "protocol": "http", "host": ["127","0","0","1"], "port": "8000", "path": ["api","v1","auth","login"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}" }
      }
    },
    {
      "name": "List Tasks",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "http://127.0.0.1:8000/api/v1/tasks", "protocol": "http", "host": ["127","0","0","1"], "port": "8000", "path": ["api","v1","tasks"] }
      }
    },
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "http://127.0.0.1:8000/api/v1/tasks", "protocol": "http", "host": ["127","0","0","1"], "port": "8000", "path": ["api","v1","tasks"] },
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Sample Task\",\n  \"description\": \"Description\"\n}" }
      }
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "http://127.0.0.1:8000/api/v1/tasks/1", "protocol": "http", "host": ["127","0","0","1"], "port": "8000", "path": ["api","v1","tasks","1"] },
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"done\"\n}" }
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "http://127.0.0.1:8000/api/v1/tasks/1", "protocol": "http", "host": ["127","0","0","1"], "port": "8000", "path": ["api","v1","tasks","1"] }
      }
    }
  ],
  "variable": [ { "key": "token", "value": "" } ]
}
